// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                  String           @id @default(uuid())
  name                String
  slug                String           @unique
  description         String?
  price               Float
  images              String[]
  active              Boolean          @default(true)
  featured            Boolean          @default(false)
  type                ProductType      @default(OTHER)
  supportsDoublePrint Boolean          @default(false)
  categoryId          String
  category            Category         @relation(fields: [categoryId], references: [id])
  variants            ProductVariant[]
  productImages       ProductImage[]
  printAreas          PrintArea[]
  orderItems          OrderItem[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([active])
  @@index([featured])
  @@index([type])
}

model ProductVariant {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  color         String
  colorHex      String
  size          String
  priceOverride Float?
  stock         Int         @default(0)
  available     Boolean     @default(true)
  sku           String?     @unique
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  imageLinks    VariantImage[]

  @@unique([productId, color, size])
  @@index([productId])
  @@index([available])
}

enum ImageSide {
  FRONT
  BACK
}

model ProductImage {
  id         String         @id @default(uuid())
  productId  String
  product    Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  color      String
  side       ImageSide
  url        String
  fileName   String?
  sortOrder  Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  variants   VariantImage[]

  @@unique([productId, color, side])
  @@index([productId, color, side])
}

model VariantImage {
  variantId String
  imageId   String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  image     ProductImage   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([variantId, imageId])
}

model PrintArea {
  id        String    @id @default(uuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  side      ImageSide
  x         Float     @default(0.27)
  y         Float     @default(0.165)
  width     Float     @default(0.46)
  height    Float     @default(0.66)
  enabled   Boolean   @default(true)
  updatedAt DateTime  @updatedAt

  @@unique([productId, side])
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String?
  shippingAddress String
  status          OrderStatus @default(PENDING)
  total           Float
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id                 String          @id @default(uuid())
  orderId            String
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId          String
  product            Product         @relation(fields: [productId], references: [id])
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id])
  productName        String // Preserved at time of order
  variantColor       String? // Preserved at time of order
  variantSize        String? // Preserved at time of order
  quantity           Int
  price              Float // Price at time of order
  customizationData  Json? // Store design/customization details
  createdAt          DateTime        @default(now())

  @@index([orderId])
  @@index([productId])
}

model Design {
  id          String   @id @default(uuid())
  productId   String
  variantId   String?
  designData  Json // Store canvas/design configuration
  previewUrl  String? // Generated preview image
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([productId])
  @@index([createdAt])
}

model Admin {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("admin")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  TSHIRT
  HOODIE
  POLO
  JOGGER
  TOTE_BAG
  CAP
  OTHER
}
