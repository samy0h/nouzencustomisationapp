# Environment
NODE_ENV=production
PORT=3001

# Database
# For Render: use the Internal Database URL from your PostgreSQL service
DATABASE_URL="postgresql://username:password@hostname:5432/database_name?schema=public"

# CORS
# Comma-separated list of allowed frontend origins
# Example for production: https://nouzen-clothes.netlify.app,https://www.nouzen-clothes.com
CORS_ORIGIN=http://localhost:5173

# Admin Authentication
# CRITICAL: Change these secrets in production!
ADMIN_AUTH_SECRET=nouzen-admin-auth-secret-change-me-in-production
ADMIN_SAMY_PASSWORD=Nouzen#746878
ADMIN_AKRAM_PASSWORD=Nouzen#746878

# Order Email Notifications
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_...
# Email address where order notifications will be sent
ORDER_NOTIFICATION_EMAIL=orders@example.com
# Sender email (must be from a Resend-verified domain in production)
# During development, defaults to: Nouzen Orders <onboarding@resend.dev>
RESEND_FROM_EMAIL=

# SECURITY WARNING:
# Never commit the actual .env file or expose these secrets in the frontend.
# The frontend must never receive RESEND_API_KEY or admin credentials.
