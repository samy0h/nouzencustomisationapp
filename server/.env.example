# Environment
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/nouzen_db?schema=public"

# CORS
CORS_ORIGIN=http://localhost:5173

# Admin Authentication
ADMIN_AUTH_SECRET=nouzen-admin-auth-secret-change-me-in-production
ADMIN_SAMY_PASSWORD=Nouzen#746878
ADMIN_AKRAM_PASSWORD=Nouzen#746878

# Order email notifications
RESEND_API_KEY=re_...
ORDER_NOTIFICATION_EMAIL=orders@example.com
# Optional during development: defaults to Nouzen Orders <onboarding@resend.dev>.
# Use a mailbox on a Resend-verified domain after launch.
RESEND_FROM_EMAIL=

# The frontend must never receive or define RESEND_API_KEY or admin credentials.
